// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Status {
  ACTIVE
  SUSPENDED
}

enum Updated_by {
  ADMIN
  ORDER
}

enum Type {
  SALE
  PAYMENT
}

model Supplier {
  id             String   @id @default(uuid())
  name           String
  payable_amount Decimal  @db.Decimal(20, 4)
  ph_no          String
  email          String   @unique
  address        String
  credit_limit   Decimal  @db.Decimal(20, 4)
  status         Status
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  Material_Order             Material_Order[]
  Material_Transition_Record Material_Transition_Record[]
}

model Raw_Material {
  id            String   @id @default(uuid())
  name          String
  current_price Decimal  @db.Decimal(10, 4)
  current_stock Decimal  @db.Decimal(6, 2)
  created_at    DateTime @default(now())

  Material_Order_Items  Material_Order_Items[]
  Material_Price_Record Material_Price_Record[]
  Material_Stock_Record Material_Stock_Record[]
}

model Material_Order {
  id          String   @id @default(uuid())
  supplier_id String
  order_date  DateTime @default(now())
  grand_total Decimal  @db.Decimal(20, 4)

  supplier Supplier @relation(fields: [supplier_id], references: [id])

  Material_Order_Items       Material_Order_Items[]
  Material_Transition_Record Material_Transition_Record[]
}

model Material_Order_Items {
  id                String  @id @default(uuid())
  material_order_id String
  raw_material_id   String
  quantity          Decimal @db.Decimal(6, 2) // get from material stock record table by enddate is NULL & material id
  unit_price        Decimal @db.Decimal(10, 4) // get from price record table by enddate is NULL & material id
  total_amount      Decimal @db.Decimal(20, 4)

  material_order Material_Order @relation(fields: [material_order_id], references: [id])
  raw_material   Raw_Material   @relation(fields: [raw_material_id], references: [id])
}

model Material_Price_Record {
  id              String    @id @default(uuid())
  raw_material_id String
  price           Decimal   @db.Decimal(10, 4)
  start_date      DateTime  @default(now())
  end_date        DateTime? // if not changed yet, null will be default

  raw_material Raw_Material @relation(fields: [raw_material_id], references: [id])
}

model Material_Stock_Record {
  id              String     @id @default(uuid())
  raw_material_id String
  stock           Decimal    @db.Decimal(6, 2)
  start_date      DateTime   @default(now())
  end_date        DateTime? // if not changed yet, Null will be default 
  updated_by      Updated_by

  raw_material Raw_Material @relation(fields: [raw_material_id], references: [id])
}

model Material_Transition_Record {
  id                String   @id @default(uuid())
  material_order_id String?
  supplier_id       String
  amount            Decimal  @db.Decimal(20, 4) // negative when customer pays
  type              Type
  updated_at        DateTime @updatedAt

  material_order Material_Order? @relation(fields: [material_order_id], references: [id])
  supplier       Supplier        @relation(fields: [supplier_id], references: [id])
}
